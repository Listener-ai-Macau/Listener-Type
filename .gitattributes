# Normalize line endings. core.autocrlf=true on Windows would otherwise rewrite
# text files to CRLF on checkout, which breaks source-assertion unit tests that
# match include_str!/readFileSync output against LF line-ending patterns.
# Source files keep LF in both the repo and the working tree.

.gitattributes text eol=lf
*.rs     text eol=lf
*.toml   text eol=lf
*.json   text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.py     text eol=lf
*.onnx   binary
src-tauri/resources/models/*.LICENSE.txt text eol=lf

# Windows-only scripts keep CRLF.
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf
